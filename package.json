{
  "name": "aios-bullmq-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "A modern, professional dashboard for BullMQ with a refreshed UI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fellahealth/aios-bullmq-dashboard.git"
  },
  "homepage": "https://github.com/fellahealth/aios-bullmq-dashboard#readme",
  "bugs": {
    "url": "https://github.com/fellahealth/aios-bullmq-dashboard/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "dev:ui": "yarn workspace @aios-medical/bullmq-dashboard-ui dev",
    "clean": "yarn workspaces run clean",
    "typecheck": "yarn workspaces run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
