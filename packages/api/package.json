{
  "name": "@aios-medical/bullmq-dashboard-api",
  "version": "1.0.2",
  "description": "Framework-agnostic API for the aios bullmq dashboard.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fellahealth/aios-bullmq-dashboard.git",
    "directory": "packages/api"
  },
  "homepage": "https://github.com/fellahealth/aios-bullmq-dashboard#readme",
  "bugs": {
    "url": "https://github.com/fellahealth/aios-bullmq-dashboard/issues"
  },
  "keywords": [
    "bull",
    "bullmq",
    "redis",
    "queue",
    "monitoring",
    "dashboard",
    "aios"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist",
    "typings",
    "*Adapter.*"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./dist/*": "./dist/*",
    "./typings/*": "./typings/*.d.ts",
    "./bullMQAdapter": "./bullMQAdapter.js",
    "./bullAdapter": "./bullAdapter.js",
    "./baseAdapter": "./baseAdapter.d.ts",
    "./constants/statuses": "./dist/constants/statuses.js"
  },
  "scripts": {
    "build": "yarn clean && tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "redis-info": "^3.1.0"
  },
  "devDependencies": {
    "@types/redis-info": "^3.0.3",
    "bull": "^4.16.5",
    "bullmq": "^6.0.3",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@aios-medical/bullmq-dashboard-ui": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
